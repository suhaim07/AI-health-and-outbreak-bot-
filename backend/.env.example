# Any one of these keys works. The provider is auto-detected from the key prefix.
# Groq keys start with "gsk_"; OpenRouter keys start with "sk-or-"; OpenAI keys start with "sk-".
AI_API_KEY=YOUR_API_KEY_HERE
# GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# Optional: defaults to openai/gpt-oss-120b
# AI_MODEL=openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=openai/gpt-oss-120b

# Optional: force a custom OpenAI-compatible endpoint
# AI_API_URL=https://api.groq.com/openai/v1/chat/completions
